import gameConfiguration.*
import generadores.*
import todasLasPreguntas.*
import azar.*
import respuestas.*
import wollok.game.*

program MinijuegoEstudiante {
	//Se agrega todas las config
	gameConfig.configurarTodo()
	
	
	// 2. Pedimos una pregunta aleatoria al nuevo objeto
	const preguntaActual = bancoDePreguntas.preguntaAleatoria()
	
	// 3. Le pasamos únicamente la lista de letras a la respuesta actual
	respuestaActual.setearRespuestaEsperada(preguntaActual.letras())
	
	// (Opcional guardado): Si querés guardar la pregunta en algún lado para cuando armen el HUD, 
	// podés dejarla accesible, pero para arrancar el juego solo te interesan sus letras.
	// 4. Arrancamos los generadores con el abecedario o letras disponibles
	generadorDeLetras.iniciar()
	generadorDeObstaculos.iniciar()
	generadorDeAyudas.iniciar()
	game.start()
}