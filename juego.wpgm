import gameConfiguration.*
import generadores.*
import todasLasPreguntas.*
import azar.*
import respuestas.*
import wollok.game.*

program MinijuegoEstudiante {
	//Se agrega todas las config
	gameConfig.configurarTodo()
	// 1. Obtenemos la pregunta
    const preguntaElegida = bancoDePreguntas.preguntaAleatoria()
    
    // 2. SE LA CARGAMOS AL SISTEMA DEL COMPAÑERO (Esto hace que aparezca el texto)
    gameConfig.cargarPregunta(preguntaElegida)
	
	gameConfig.conectarPista(pistaDelJuego)
	
	// 3. Le pasamos únicamente la lista de letras a la respuesta actual
	respuestaActual.setearRespuestaEsperada(preguntaElegida.letras())

	game.start()
}