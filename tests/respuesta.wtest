import respuestas.*
import estudiante.*

describe "Pruebas del sistema de respuestas y validación de letras" {
  method initialize() {
    // Esto se ejecuta automáticamente ANTES de cada test.
    // Preparamos el objeto con una palabra de prueba.
    respuestaActual.setearRespuestaEsperada(["P", "D", "E", "P"])
  }
  
  test "Agarrar la letra correcta la suma a la palabra armada y no resta vida" {
    const vidaInicial = estudiante.concentracion()
    
    // La primera letra esperada es la "P"
    respuestaActual.agregarLetra("P")
    
    // Verificamos que la letra se guardó
    assert.equals("P", respuestaActual.palabraArmada())
    
    // Verificamos que el estudiante no fue penalizado
    assert.equals(vidaInicial, estudiante.concentracion())
  }
  
  test "Agarrar una letra incorrecta rechaza la letra y le resta vida al estudiante" {
    const vidaInicial = estudiante.concentracion()
    
    // La primera letra esperada es "P", pero el jugador agarra una "X"
    respuestaActual.agregarLetra("X")
    
    // La palabra armada debe seguir vacía porque se rechazó el ingreso
    assert.equals("", respuestaActual.palabraArmada())
    
    // El estudiante debió perder 1 de concentración
    assert.equals(vidaInicial - 1, estudiante.concentracion())
  }
  
  test "Completar toda la palabra activa la condición de victoria/completado" {
    // Simulamos que el jugador agarra todas las letras bien y en orden
    respuestaActual.agregarLetra("P")
    respuestaActual.agregarLetra("D")
    respuestaActual.agregarLetra("E")
    respuestaActual.agregarLetra("P")
    
    // Verificamos que se concatenó correctamente
    assert.equals("PDEP", respuestaActual.palabraArmada())
    
    // Verificamos que el estado de la respuesta ahora es completo (para el CP2)
    assert.that(respuestaActual.estaCompleta())
  }
}